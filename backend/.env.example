# PaperScholar Environment Configuration Example
# Copy this file to .env and fill in your values

APP_NAME=PaperScholar
APP_ENV=development
DEBUG=true

# IMPORTANT: Change these in production!
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=change-me-to-another-long-random-string
API_KEY_ENCRYPTION_KEY=   # Optional: Fernet key (44 chars). If empty, derived from SECRET_KEY

# Registration invite code (REQUIRED for user registration)
INVITE_CODE=your-invite-code-here
INVITE_CODE_MAX_USES=100

# Database
DATABASE_URL=postgresql+asyncpg://paperscholar:paperscholar@localhost:5432/paperscholar

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@paperscholar.local
